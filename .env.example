# Public — safe to expose to the browser (used by the Vite app itself)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — used ONLY by scripts/add-user.mjs and scripts/migrate-from-json.mjs,
# run locally from a terminal. NEVER put this in Netlify env vars or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
